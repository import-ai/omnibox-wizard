OBW_VECTOR_EMBEDDING_API_KEY="***"
OBW_VECTOR_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OBW_VECTOR_EMBEDDING_MODEL="text-embedding-v1"
OBW_VECTOR_DIMENSION="1536"

OBW_VECTOR_WEAVIATE_HOST="localhost"
OBW_VECTOR_WEAVIATE_PORT="8080"
OBW_VECTOR_WEAVIATE_GRPC_PORT="50051"
OBW_VECTOR_WEAVIATE_API_KEY="omnibox"

OBW_GRIMOIRE_OPENAI_DEFAULT_API_KEY="***"
OBW_GRIMOIRE_OPENAI_DEFAULT_BASE_URL="https://api.openai.com/v1"
OBW_GRIMOIRE_OPENAI_DEFAULT_MODEL="gpt-4o"
OBW_GRIMOIRE_OPENAI_MINI_MODEL="gpt-4o-mini"
OBW_GRIMOIRE_OPENAI_LARGE_MODEL="gpt-4.1"
OBW_GRIMOIRE_OPENAI_LARGE_THINKING_MODEL="o3"

OBW_GRIMOIRE_CUSTOM_TOOL_CALL=true

OBW_TASK_SPLITER_CHUNK_SIZE=1024
OBW_TASK_SPLITER_CHUNK_OVERLAP=128

OBW_TASK_OFFICE_OPERATOR_BASE_URL="https://example.com"

OBW_TASK_DOCLING_BASE_URL="http://localhost:5001"
OBW_TASK_FILE_CONTENT_LENGTH_LIMIT=32768

OBW_TASK_SCRAPE_BASE_URL="http://localhost:8000"

OBW_BACKEND_BASE_URL="http://127.0.0.1:8000"

OBW_CALLBACK_CHUNK_SIZE=5242880
OBW_CALLBACK_USE_CHUNKED=true

OBW_TOOLS_SEARXNG_BASE_URL="https://searx.be"
OBW_TOOLS_SEARXNG_ENGINES=""

OBW_TOOLS_RERANKER_OPENAI_API_KEY="***"
OBW_TOOLS_RERANKER_OPENAI_MODEL="reranker"
OBW_TOOLS_RERANKER_OPENAI_BASE_URL="https://api.openai.com/v1"
OBW_TOOLS_RERANKER_THRESHOLD=0.1
OBW_TOOLS_RERANKER_K=20

# Optional private model catalog. Use the same catalog in both Wizard services.
# Restart the Wizard services after changing this configuration.
# Open-source deployments need only basic; pro and default are optional.
# Without OBW_MODELS, existing model settings and chat behavior remain available.
# Choose model names and parameters supported by your provider; these are examples.
# Fixed-mode models: omit parameters and assign a different model to each level.
# Toggle models: use enable_thinking false/true. Effort models: use reasoning_effort.
# Level IDs and Default step order are configurable; labels are translated by Web.
# The backend and browser receive only edition/level selections, never these model settings.
# OBW_MODELS='{"basic":{"default_level":"low","levels":[{"id":"low","model":"ZHIPU/GLM-5.3-Flash","parameters":{"reasoning_effort":"low"}},{"id":"high","model":"ZHIPU/GLM-5.3-Flash","parameters":{"reasoning_effort":"high"}},{"id":"max","model":"ZHIPU/GLM-5.3-Flash","parameters":{"reasoning_effort":"max"}}]},"pro":{"default_level":"low","levels":[{"id":"low","model":"ZHIPU/GLM-5.3","parameters":{"reasoning_effort":"low"}},{"id":"high","model":"ZHIPU/GLM-5.3","parameters":{"reasoning_effort":"high"}},{"id":"max","model":"ZHIPU/GLM-5.3","parameters":{"reasoning_effort":"max"}}]},"default":{"default_step":"pro.low","steps":["basic.low","basic.high","basic.max","pro.low","pro.high","pro.max"]},"prices":{"ZHIPU/GLM-5.3-Flash":{"input":80,"input_cached":23,"output":280},"ZHIPU/GLM-5.3":{"input":800,"input_cached":200,"output":2800}}}'
# prices maps model names to input/input_cached/output credits per million tokens.
# Prices are private. Basic calls are free; paid Pro calls require configured prices.
# Legacy requests use the configured edition default when OBW_MODELS is present.
